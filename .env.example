# Prediction provider: 'demo' (default) or 'api'
VITE_PREDICTION_PROVIDER=demo

# Base URL for FastAPI backend when provider is 'api'
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional: proxy API calls from Vite dev server (e.g. '/api')
# VITE_API_PROXY=/api

# Note: No secrets or credentials should be stored here; this is a demo prototype.
